# Uygulama (capacitor://localhost, http://localhost) arşiv listesini ve oynatıcıyı
# buradan çeker; CORS başlığı olmadan fetch tarayıcı tarafından engelleniyor.
/yt/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Dinleyerek takip varlıkları: uygulama IndexedDB'ye indirir; büyük ve değişmez
/dinle/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
